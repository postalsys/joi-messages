msgid ""
msgstr ""
"Project-Id-Version: \n"
"POT-Creation-Date: \n"
"PO-Revision-Date: \n"
"Last-Translator: \n"
"Language-Team: \n"
"Language: sv\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# Label: any.custom
#: any.custom
msgid "{{#label}} failed custom validation because {{#error.message}}"
msgstr ""
"{{#label}} klarade inte den anpassade valideringen: {{#error.message}}"

# Label: any.default
#: any.default
msgid "{{#label}} threw an error when running default method"
msgstr "Ett fel uppstod när standardvärdet för {{#label}} skulle beräknas"

# Label: any.failover
#: any.failover
msgid "{{#label}} threw an error when running failover method"
msgstr "Ett fel uppstod när reservvärdet för {{#label}} skulle beräknas"

# Label: any.invalid
#: any.invalid
msgid "{{#label}} contains an invalid value"
msgstr "{{#label}} innehåller ett ogiltigt värde"

# Label: any.only
#: any.only
msgid ""
"{{#label}} must be {if(#valids.length == 1, \"\", \"one of \")}{{#valids}}"
msgstr ""
"{{#label}} måste vara {if(#valids.length == 1, \"\", \"något av följande: "
"\")}{{#valids}}"

# Label: any.ref
#: any.ref
msgid "{{#label}} {{#arg}} references {{:#ref}} which {{#reason}}"
msgstr ""
"{{#label}}: argumentet {{#arg}} hänvisar till {{:#ref}}: {{#reason}}"

# Label: any.required
#: any.required
msgid "{{#label}} is required"
msgstr "{{#label}} är obligatoriskt"

# Label: object.unknown
#: object.unknown
msgid "{{#label}} is not allowed"
msgstr "{{#label}} är inte tillåtet"

# Label: alternatives.all
#: alternatives.all
msgid "{{#label}} does not match all of the required types"
msgstr "{{#label}} uppfyller inte kraven för samtliga angivna typer"

# Label: array.includes
#: array.includes
msgid "{{#label}} does not match any of the allowed types"
msgstr "{{#label}} matchar ingen av de tillåtna typerna"

# Label: alternatives.one
#: alternatives.one
msgid "{{#label}} matches more than one allowed type"
msgstr "{{#label}} matchar fler än en tillåten typ"

# Label: alternatives.types
#: alternatives.types
msgid "{{#label}} must be one of {{#types}}"
msgstr "{{#label}} måste ha någon av följande typer: {{#types}}"

# Label: array.base
#: array.base
msgid "{{#label}} must be an array"
msgstr "{{#label}} måste vara en array"

# Label: array.excludes
#: array.excludes
msgid "{{#label}} contains an excluded value"
msgstr "{{#label}} innehåller ett otillåtet värde"

# Label: array.hasKnown
#: array.hasKnown
msgid ""
"{{#label}} does not contain at least one required match for type "
"{:#patternLabel}"
msgstr ""
"{{#label}} måste innehålla minst ett element som uppfyller kraven för "
"{:#patternLabel}"

# Label: array.hasUnknown
#: array.hasUnknown
msgid "{{#label}} does not contain at least one required match"
msgstr ""
"{{#label}} måste innehålla minst ett element som uppfyller det angivna "
"villkoret"

# Label: array.includesRequiredBoth
#: array.includesRequiredBoth
msgid ""
"{{#label}} does not contain {{#knownMisses}} and {{#unknownMisses}} other "
"required value(s)"
msgstr ""
"{{#label}} saknar {{#knownMisses}} och {{#unknownMisses}} ytterligare "
"obligatorisk{if(#unknownMisses == 1, \"t värde\", \"a värden\")}"

# Label: array.includesRequiredKnowns
#: array.includesRequiredKnowns
msgid "{{#label}} does not contain {{#knownMisses}}"
msgstr "{{#label}} saknar {{#knownMisses}}"

# Label: array.includesRequiredUnknowns
#: array.includesRequiredUnknowns
msgid "{{#label}} does not contain {{#unknownMisses}} required value(s)"
msgstr ""
"{{#label}} saknar {{#unknownMisses}} obligatorisk{if(#unknownMisses == 1, "
"\"t värde\", \"a värden\")}"

# Label: array.length
#: array.length
msgid "{{#label}} must contain {{#limit}} items"
msgstr "{{#label}} måste innehålla exakt {{#limit}} element"

# Label: array.max
#: array.max
msgid "{{#label}} must contain less than or equal to {{#limit}} items"
msgstr "{{#label}} får innehålla högst {{#limit}} element"

# Label: array.min
#: array.min
msgid "{{#label}} must contain at least {{#limit}} items"
msgstr "{{#label}} måste innehålla minst {{#limit}} element"

# Label: array.orderedLength
#: array.orderedLength
msgid "{{#label}} must contain at most {{#limit}} items"
msgstr "{{#label}} får innehålla högst {{#limit}} element"

# Label: array.sort
#: array.sort
msgid "{{#label}} must be sorted in {#order} order by {{#by}}"
msgstr ""
"{{#label}} måste vara sorterat i {if(#order == \"ascending\", \"stigande\", "
"if(#order == \"descending\", \"fallande\", #order))} ordning efter {{#by}}"

# Label: array.sort.mismatching
#: array.sort.mismatching
msgid "{{#label}} cannot be sorted due to mismatching types"
msgstr "{{#label}} kan inte sorteras eftersom värdena har olika datatyper"

# Label: array.sort.unsupported
#: array.sort.unsupported
msgid "{{#label}} cannot be sorted due to unsupported type {#type}"
msgstr "{{#label}} kan inte sorteras eftersom typen {#type} inte stöds"

# Label: array.sparse
#: array.sparse
msgid "{{#label}} must not be a sparse array item"
msgstr "{{#label}} får inte ha värdet undefined"

# Label: array.unique
#: array.unique
msgid "{{#label}} contains a duplicate value"
msgstr "{{#label}} innehåller samma värde flera gånger"

# Label: boolean.base
#: boolean.base
msgid "{{#label}} must be a boolean"
msgstr "{{#label}} måste vara ett booleskt värde (true eller false)"

# Label: date.base
#: date.base
msgid "{{#label}} must be a valid date"
msgstr "{{#label}} måste vara ett giltigt datum"

# Label: date.format
#: date.format
msgid ""
"{{#label}} must be in {msg(\"date.format.\" + #format) || #format} format"
msgstr ""
"{{#label}} måste anges som {msg(\"date.format.\" + #format) || #format}"

# Label: date.greater
#: date.greater
msgid "{{#label}} must be greater than {{:#limit}}"
msgstr "{{#label}} måste vara senare än {{:#limit}}"

# Label: date.less
#: date.less
msgid "{{#label}} must be less than {{:#limit}}"
msgstr "{{#label}} måste vara tidigare än {{:#limit}}"

# Label: date.max
#: date.max
msgid "{{#label}} must be less than or equal to {{:#limit}}"
msgstr "{{#label}} får inte vara senare än {{:#limit}}"

# Label: date.min
#: date.min
msgid "{{#label}} must be greater than or equal to {{:#limit}}"
msgstr "{{#label}} får inte vara tidigare än {{:#limit}}"

# Label: date.format.iso
#: date.format.iso
msgid "ISO 8601 date"
msgstr "ett datum enligt ISO 8601"

# Label: date.format.javascript
#: date.format.javascript
msgid "timestamp or number of milliseconds"
msgstr "en tidsstämpel i millisekunder"

# Label: date.format.unix
#: date.format.unix
msgid "timestamp or number of seconds"
msgstr "en tidsstämpel i sekunder"

# Label: object.and
#: object.and
msgid ""
"{{#label}} contains {{#presentWithLabels}} without its required peers "
"{{#missingWithLabels}}"
msgstr ""
"{{#label}} innehåller {{#presentWithLabels}}, men måste då också "
"innehålla {{#missingWithLabels}}"

# Label: object.assert
#: object.assert
msgid ""
"{{#label}} is invalid because {if(#subject.key, `\"` + #subject.key + `\" "
"failed to ` + (#message || \"pass the assertion test\"), #message || \"the "
"assertion failed\")}"
msgstr ""
"{{#label}} uppfyller inte villkoret{if(#subject.key, ` för \"` + "
"#subject.key + `\"`, \"\")}{if(#message, \": \" + #message, \"\")}"

# Label: object.base
#: object.base
msgid "{{#label}} must be of type {{#type}}"
msgstr "{{#label}} måste vara av typen {{#type}}"

# Label: object.instance
#: object.instance
msgid "{{#label}} must be an instance of {{:#type}}"
msgstr "{{#label}} måste vara en instans av {{:#type}}"

# Label: object.length
#: object.length
msgid "{{#label}} must have {{#limit}} key{if(#limit == 1, \"\", \"s\")}"
msgstr ""
"{{#label}} måste innehålla exakt {{#limit}} {if(#limit == 1, \"nyckel\", "
"\"nycklar\")}"

# Label: object.max
#: object.max
msgid ""
"{{#label}} must have less than or equal to {{#limit}} key{if(#limit == 1, "
"\"\", \"s\")}"
msgstr ""
"{{#label}} får innehålla högst {{#limit}} {if(#limit == 1, \"nyckel\", "
"\"nycklar\")}"

# Label: object.min
#: object.min
msgid ""
"{{#label}} must have at least {{#limit}} key{if(#limit == 1, \"\", \"s\")}"
msgstr ""
"{{#label}} måste innehålla minst {{#limit}} {if(#limit == 1, \"nyckel\", "
"\"nycklar\")}"

# Label: object.missing
#: object.missing
msgid "{{#label}} must contain at least one of {{#peersWithLabels}}"
msgstr ""
"{{#label}} måste innehålla minst en av följande nycklar: {{#peersWithLabels}}"

# Label: object.nand
#: object.nand
msgid ""
"{{:#mainWithLabel}} must not exist simultaneously with {{#peersWithLabels}}"
msgstr ""
"{{:#mainWithLabel}} får inte förekomma tillsammans med alla följande "
"nycklar: {{#peersWithLabels}}"

# Label: object.oxor
#: object.oxor
msgid ""
"{{#label}} contains a conflict between optional exclusive peers "
"{{#peersWithLabels}}"
msgstr ""
"{{#label}} får innehålla högst en av följande nycklar: {{#peersWithLabels}}"

# Label: object.pattern.match
#: object.pattern.match
msgid "{{#label}} keys failed to match pattern requirements"
msgstr "Nycklarna i {{#label}} uppfyller inte mönstrets krav"

# Label: object.refType
#: object.refType
msgid "{{#label}} must be a Joi reference"
msgstr "{{#label}} måste vara en Joi-referens"

# Label: object.regex
#: object.regex
msgid "{{#label}} must be a RegExp object"
msgstr "{{#label}} måste vara ett RegExp-objekt"

# Label: object.rename.multiple
#: object.rename.multiple
msgid ""
"{{#label}} cannot rename {{:#from}} because multiple renames are disabled "
"and another key was already renamed to {{:#to}}"
msgstr ""
"{{#label}}: {{:#from}} kan inte byta namn till {{:#to}} eftersom en annan "
"nyckel redan har fått det namnet och flera nycklar inte får ges samma namn"

# Label: object.rename.override
#: object.rename.override
msgid ""
"{{#label}} cannot rename {{:#from}} because override is disabled and target "
"{{:#to}} exists"
msgstr ""
"{{#label}}: {{:#from}} kan inte byta namn till {{:#to}} eftersom den "
"nyckeln redan finns och inte får skrivas över"

# Label: object.rename.proto
#: object.rename.proto
msgid ""
"{{#label}} cannot rename {{:#from}} because target {{:#to}} is a reserved key"
msgstr ""
"{{#label}}: {{:#from}} kan inte byta namn till {{:#to}} eftersom det är "
"ett reserverat nyckelnamn"

# Label: object.schema
#: object.schema
msgid "{{#label}} must be a Joi schema of {{#type}} type"
msgstr "{{#label}} måste vara ett Joi-schema av typen {{#type}}"

# Label: object.with
#: object.with
msgid "{{:#mainWithLabel}} missing required peer {{:#peerWithLabel}}"
msgstr ""
"När {{:#mainWithLabel}} finns måste även {{:#peerWithLabel}} finnas"

# Label: object.without
#: object.without
msgid "{{:#mainWithLabel}} conflict with forbidden peer {{:#peerWithLabel}}"
msgstr ""
"{{:#mainWithLabel}} får inte förekomma tillsammans med {{:#peerWithLabel}}"

# Label: object.xor
#: object.xor
msgid ""
"{{#label}} contains a conflict between exclusive peers {{#peersWithLabels}}"
msgstr ""
"{{#label}} måste innehålla exakt en av följande nycklar: {{#peersWithLabels}}"

# Label: function.arity
#: function.arity
msgid "{{#label}} must have an arity of {{#n}}"
msgstr ""
"{{#label}} måste ha exakt {{#n}} {if(#n == 1, \"parameter\", \"parametrar\")}"

# Label: function.class
#: function.class
msgid "{{#label}} must be a class"
msgstr "{{#label}} måste vara en klass"

# Label: function.maxArity
#: function.maxArity
msgid "{{#label}} must have an arity lesser or equal to {{#n}}"
msgstr ""
"{{#label}} får ha högst {{#n}} {if(#n == 1, \"parameter\", \"parametrar\")}"

# Label: function.minArity
#: function.minArity
msgid "{{#label}} must have an arity greater or equal to {{#n}}"
msgstr ""
"{{#label}} måste ha minst {{#n}} {if(#n == 1, \"parameter\", \"parametrar\")}"

# Label: link.depth
#: link.depth
msgid "{{#label}} exceeds maximum recursion depth supported by the runtime"
msgstr ""
"{{#label}} överskrider det maximala rekursionsdjup som körmiljön stöder"

# Label: link.maxRecursion
#: link.maxRecursion
msgid "{{#label}} exceeds maximum recursion depth of {{#limit}}"
msgstr "{{#label}} överskrider det maximala rekursionsdjupet {{#limit}}"

# Label: number.base
#: number.base
msgid "{{#label}} must be a number"
msgstr "{{#label}} måste vara ett tal"

# Label: number.greater
#: number.greater
msgid "{{#label}} must be greater than {{#limit}}"
msgstr "{{#label}} måste vara större än {{#limit}}"

# Label: number.infinity
#: number.infinity
msgid "{{#label}} cannot be infinity"
msgstr "{{#label}} får inte vara oändligt"

# Label: number.integer
#: number.integer
msgid "{{#label}} must be an integer"
msgstr "{{#label}} måste vara ett heltal"

# Label: number.less
#: number.less
msgid "{{#label}} must be less than {{#limit}}"
msgstr "{{#label}} måste vara mindre än {{#limit}}"

# Label: number.max
#: number.max
msgid "{{#label}} must be less than or equal to {{#limit}}"
msgstr "{{#label}} får vara högst {{#limit}}"

# Label: number.min
#: number.min
msgid "{{#label}} must be greater than or equal to {{#limit}}"
msgstr "{{#label}} måste vara minst {{#limit}}"

# Label: number.multiple
#: number.multiple
msgid "{{#label}} must be a multiple of {{#multiple}}"
msgstr "{{#label}} måste vara en multipel av {{#multiple}}"

# Label: number.negative
#: number.negative
msgid "{{#label}} must be a negative number"
msgstr "{{#label}} måste vara ett negativt tal"

# Label: number.port
#: number.port
msgid "{{#label}} must be a valid port"
msgstr "{{#label}} måste vara ett giltigt portnummer"

# Label: number.positive
#: number.positive
msgid "{{#label}} must be a positive number"
msgstr "{{#label}} måste vara ett positivt tal"

# Label: number.precision
#: number.precision
msgid "{{#label}} must have no more than {{#limit}} decimal places"
msgstr ""
"{{#label}} får ha högst {{#limit}} decimal{if(#limit == 1, \"\", \"er\")}"

# Label: number.unsafe
#: number.unsafe
msgid "{{#label}} must be a safe number"
msgstr "{{#label}} måste vara ett tal som JavaScript kan representera säkert"

# Label: string.alphanum
#: string.alphanum
msgid "{{#label}} must only contain alpha-numeric characters"
msgstr ""
"{{#label}} får bara innehålla bokstäver (a–z, A–Z) och siffror (0–9)"

# Label: string.base
#: string.base
msgid "{{#label}} must be a string"
msgstr "{{#label}} måste vara en sträng"

# Label: string.base64
#: string.base64
msgid "{{#label}} must be a valid base64 string"
msgstr "{{#label}} måste vara en giltig Base64-sträng"

# Label: string.creditCard
#: string.creditCard
msgid "{{#label}} must be a credit card"
msgstr "{{#label}} måste vara ett giltigt kreditkortsnummer"

# Label: string.dataUri
#: string.dataUri
msgid "{{#label}} must be a valid dataUri string"
msgstr "{{#label}} måste vara en giltig data-URI"

# Label: string.domain
#: string.domain
msgid "{{#label}} must contain a valid domain name"
msgstr "{{#label}} måste innehålla ett giltigt domännamn"

# Label: string.email
#: string.email
msgid "{{#label}} must be a valid email"
msgstr "{{#label}} måste vara en giltig e-postadress"

# Label: string.empty
#: string.empty
msgid "{{#label}} is not allowed to be empty"
msgstr "{{#label}} får inte vara tomt"

# Label: string.guid
#: string.guid
msgid "{{#label}} must be a valid GUID"
msgstr "{{#label}} måste vara ett giltigt GUID"

# Label: string.hex
#: string.hex
msgid "{{#label}} must only contain hexadecimal characters"
msgstr "{{#label}} får bara innehålla hexadecimala tecken"

# Label: string.hexAlign
#: string.hexAlign
msgid "{{#label}} hex decoded representation must be byte aligned"
msgstr ""
"{{#label}} måste innehålla ett jämnt antal hexadecimala tecken"

# Label: string.hostname
#: string.hostname
msgid "{{#label}} must be a valid hostname"
msgstr "{{#label}} måste vara ett giltigt värdnamn"

# Label: string.ip
#: string.ip
msgid "{{#label}} must be a valid ip address with a {{#cidr}} CIDR"
msgstr ""
"{{#label}} måste vara en giltig IP-adress {{if(#cidr == \"required\", "
"\"med CIDR-notation\", if(#cidr == \"optional\", \"med eller utan "
"CIDR-notation\", if(#cidr == \"forbidden\", \"utan CIDR-notation\", #cidr)))}}"

# Label: string.ipVersion
#: string.ipVersion
msgid ""
"{{#label}} must be a valid ip address of one of the following versions "
"{{#version}} with a {{#cidr}} CIDR"
msgstr ""
"{{#label}} måste vara en giltig IP-adress {{if(#cidr == \"required\", "
"\"med CIDR-notation\", if(#cidr == \"optional\", \"med eller utan "
"CIDR-notation\", if(#cidr == \"forbidden\", \"utan CIDR-notation\", "
"#cidr)))}} (tillåtna versioner: {{#version}})"

# Label: string.isoDate
#: string.isoDate
msgid "{{#label}} must be in iso format"
msgstr "{{#label}} måste vara ett datum i ISO 8601-format"

# Label: string.isoDuration
#: string.isoDuration
msgid "{{#label}} must be a valid ISO 8601 duration"
msgstr "{{#label}} måste vara en giltig tidslängd enligt ISO 8601"

# Label: string.length
#: string.length
msgid "{{#label}} length must be {{#limit}} characters long"
msgstr "{{#label}} måste innehålla exakt {{#limit}} tecken"

# Label: string.lowercase
#: string.lowercase
msgid "{{#label}} must only contain lowercase characters"
msgstr "Alla bokstäver i {{#label}} måste vara små"

# Label: string.max
#: string.max
msgid ""
"{{#label}} length must be less than or equal to {{#limit}} characters long"
msgstr "{{#label}} får innehålla högst {{#limit}} tecken"

# Label: string.min
#: string.min
msgid "{{#label}} length must be at least {{#limit}} characters long"
msgstr "{{#label}} måste innehålla minst {{#limit}} tecken"

# Label: string.normalize
#: string.normalize
msgid "{{#label}} must be unicode normalized in the {{#form}} form"
msgstr ""
"{{#label}} måste vara Unicode-normaliserat enligt {{#form}}"

# Label: string.token
#: string.token
msgid "{{#label}} must only contain alpha-numeric and underscore characters"
msgstr ""
"{{#label}} får bara innehålla bokstäver (a–z, A–Z), siffror (0–9) och "
"understreck (_)"

# Label: string.pattern.base
#: string.pattern.base
msgid ""
"{{#label}} with value {:[.]} fails to match the required pattern: {{#regex}}"
msgstr ""
"{{#label}} med värdet {:[.]} måste matcha mönstret {{#regex}}"

# Label: string.pattern.name
#: string.pattern.name
msgid "{{#label}} with value {:[.]} fails to match the {{#name}} pattern"
msgstr "{{#label}} med värdet {:[.]} måste matcha mönstret {{#name}}"

# Label: string.pattern.invert.base
#: string.pattern.invert.base
msgid "{{#label}} with value {:[.]} matches the inverted pattern: {{#regex}}"
msgstr ""
"{{#label}} med värdet {:[.]} får inte matcha mönstret {{#regex}}"

# Label: string.pattern.invert.name
#: string.pattern.invert.name
msgid "{{#label}} with value {:[.]} matches the inverted {{#name}} pattern"
msgstr "{{#label}} med värdet {:[.]} får inte matcha mönstret {{#name}}"

# Label: string.trim
#: string.trim
msgid "{{#label}} must not have leading or trailing whitespace"
msgstr ""
"{{#label}} får inte börja eller sluta med mellanslag eller andra blanktecken"

# Label: string.uri
#: string.uri
msgid "{{#label}} must be a valid uri"
msgstr "{{#label}} måste vara en giltig URI"

# Label: string.uriCustomScheme
#: string.uriCustomScheme
msgid ""
"{{#label}} must be a valid uri with a scheme matching the {{#scheme}} pattern"
msgstr ""
"{{#label}} måste vara en giltig URI med ett schema som matchar mönstret "
"{{#scheme}}"

# Label: string.uriRelativeOnly
#: string.uriRelativeOnly
msgid "{{#label}} must be a valid relative uri"
msgstr "{{#label}} måste vara en giltig relativ URI"

# Label: string.uppercase
#: string.uppercase
msgid "{{#label}} must only contain uppercase characters"
msgstr "Alla bokstäver i {{#label}} måste vara stora"

# Label: symbol.base
#: symbol.base
msgid "{{#label}} must be a symbol"
msgstr "{{#label}} måste vara av typen Symbol"

# Label: symbol.map
#: symbol.map
msgid "{{#label}} must be one of {{#map}}"
msgstr "{{#label}} måste vara något av följande: {{#map}}"

# Label: binary.base
#: binary.base
msgid "{{#label}} must be a buffer or a string"
msgstr "{{#label}} måste vara ett Buffer-objekt eller en sträng"

# Label: binary.length
#: binary.length
msgid "{{#label}} must be {{#limit}} bytes"
msgstr "{{#label}} måste vara exakt {{#limit}} byte"

# Label: binary.max
#: binary.max
msgid "{{#label}} must be less than or equal to {{#limit}} bytes"
msgstr "{{#label}} får vara högst {{#limit}} byte"

# Label: binary.min
#: binary.min
msgid "{{#label}} must be at least {{#limit}} bytes"
msgstr "{{#label}} måste vara minst {{#limit}} byte"
