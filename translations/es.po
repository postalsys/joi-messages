msgid ""
msgstr ""
"Project-Id-Version: \n"
"POT-Creation-Date: \n"
"PO-Revision-Date: \n"
"Last-Translator: \n"
"Language-Team: \n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# Label: any.custom
#: any.custom
msgid "{{#label}} failed custom validation because {{#error.message}}"
msgstr "{{#label}} no superó la validación personalizada: {{#error.message}}"

# Label: any.default
#: any.default
msgid "{{#label}} threw an error when running default method"
msgstr "Se produjo un error al calcular el valor predeterminado de {{#label}}"

# Label: any.failover
#: any.failover
msgid "{{#label}} threw an error when running failover method"
msgstr "Se produjo un error al calcular el valor de reserva de {{#label}}"

# Label: any.invalid
#: any.invalid
msgid "{{#label}} contains an invalid value"
msgstr "{{#label}} contiene un valor no válido"

# Label: any.only
#: any.only
msgid ""
"{{#label}} must be {if(#valids.length == 1, \"\", \"one of \")}{{#valids}}"
msgstr ""
"{{#label}} debe ser {if(#valids.length == 1, \"\", \"uno de los siguientes "
"valores: \")}{{#valids}}"

# Label: any.ref
#: any.ref
msgid "{{#label}} {{#arg}} references {{:#ref}} which {{#reason}}"
msgstr "{{#label}}: el argumento {{#arg}} hace referencia a {{:#ref}}: {{#reason}}"

# Label: any.required
#: any.required
msgid "{{#label}} is required"
msgstr "{{#label}} es obligatorio"

# Label: object.unknown
#: object.unknown
msgid "{{#label}} is not allowed"
msgstr "No se permite {{#label}}"

# Label: alternatives.all
#: alternatives.all
msgid "{{#label}} does not match all of the required types"
msgstr "{{#label}} no cumple los requisitos de todos los tipos indicados"

# Label: array.includes
#: array.includes
msgid "{{#label}} does not match any of the allowed types"
msgstr "{{#label}} no coincide con ninguno de los tipos permitidos"

# Label: alternatives.one
#: alternatives.one
msgid "{{#label}} matches more than one allowed type"
msgstr "{{#label}} coincide con más de un tipo permitido"

# Label: alternatives.types
#: alternatives.types
msgid "{{#label}} must be one of {{#types}}"
msgstr "{{#label}} debe ser de uno de los siguientes tipos: {{#types}}"

# Label: array.base
#: array.base
msgid "{{#label}} must be an array"
msgstr "{{#label}} debe ser un array"

# Label: array.excludes
#: array.excludes
msgid "{{#label}} contains an excluded value"
msgstr "{{#label}} contiene un valor no permitido"

# Label: array.hasKnown
#: array.hasKnown
msgid ""
"{{#label}} does not contain at least one required match for type "
"{:#patternLabel}"
msgstr ""
"{{#label}} debe contener al menos un elemento que cumpla los requisitos de "
"{:#patternLabel}"

# Label: array.hasUnknown
#: array.hasUnknown
msgid "{{#label}} does not contain at least one required match"
msgstr ""
"{{#label}} debe contener al menos un elemento que cumpla la condición "
"requerida"

# Label: array.includesRequiredBoth
#: array.includesRequiredBoth
msgid ""
"{{#label}} does not contain {{#knownMisses}} and {{#unknownMisses}} other "
"required value(s)"
msgstr ""
"En {{#label}} faltan {{#knownMisses}} y {{#unknownMisses}} "
"{if(#unknownMisses == 1, \"valor requerido\", \"valores requeridos\")} más"

# Label: array.includesRequiredKnowns
#: array.includesRequiredKnowns
msgid "{{#label}} does not contain {{#knownMisses}}"
msgstr "{{#label}} no contiene {{#knownMisses}}"

# Label: array.includesRequiredUnknowns
#: array.includesRequiredUnknowns
msgid "{{#label}} does not contain {{#unknownMisses}} required value(s)"
msgstr ""
"En {{#label}} {if(#unknownMisses == 1, \"falta\", \"faltan\")} "
"{{#unknownMisses}} {if(#unknownMisses == 1, \"valor requerido\", \"valores "
"requeridos\")}"

# Label: array.length
#: array.length
msgid "{{#label}} must contain {{#limit}} items"
msgstr ""
"{{#label}} debe contener exactamente {{#limit}} elemento{if(#limit == 1, "
"\"\", \"s\")}"

# Label: array.max
#: array.max
msgid "{{#label}} must contain less than or equal to {{#limit}} items"
msgstr ""
"{{#label}} debe contener como máximo {{#limit}} elemento{if(#limit == 1, "
"\"\", \"s\")}"

# Label: array.min
#: array.min
msgid "{{#label}} must contain at least {{#limit}} items"
msgstr ""
"{{#label}} debe contener al menos {{#limit}} elemento{if(#limit == 1, \"\", "
"\"s\")}"

# Label: array.orderedLength
#: array.orderedLength
msgid "{{#label}} must contain at most {{#limit}} items"
msgstr ""
"{{#label}} debe contener como máximo {{#limit}} elemento{if(#limit == 1, "
"\"\", \"s\")}"

# Label: array.sort
#: array.sort
msgid "{{#label}} must be sorted in {#order} order by {{#by}}"
msgstr ""
"{{#label}} debe estar ordenado por {{#by}} en orden {if(#order == "
"\"ascending\", \"ascendente\", if(#order == \"descending\", \"descendente\", "
"#order))}"

# Label: array.sort.mismatching
#: array.sort.mismatching
msgid "{{#label}} cannot be sorted due to mismatching types"
msgstr ""
"{{#label}} no se puede ordenar porque los valores tienen tipos distintos"

# Label: array.sort.unsupported
#: array.sort.unsupported
msgid "{{#label}} cannot be sorted due to unsupported type {#type}"
msgstr "{{#label}} no se puede ordenar porque el tipo {#type} no es compatible"

# Label: array.sparse
#: array.sparse
msgid "{{#label}} must not be a sparse array item"
msgstr "{{#label}} no puede tener el valor undefined"

# Label: array.unique
#: array.unique
msgid "{{#label}} contains a duplicate value"
msgstr "{{#label}} contiene un valor duplicado"

# Label: boolean.base
#: boolean.base
msgid "{{#label}} must be a boolean"
msgstr "{{#label}} debe ser un valor booleano (true o false)"

# Label: date.base
#: date.base
msgid "{{#label}} must be a valid date"
msgstr "{{#label}} debe ser una fecha válida"

# Label: date.format
#: date.format
msgid ""
"{{#label}} must be in {msg(\"date.format.\" + #format) || #format} format"
msgstr "{{#label}} debe ser {msg(\"date.format.\" + #format) || #format}"

# Label: date.greater
#: date.greater
msgid "{{#label}} must be greater than {{:#limit}}"
msgstr "{{#label}} debe ser posterior a {{:#limit}}"

# Label: date.less
#: date.less
msgid "{{#label}} must be less than {{:#limit}}"
msgstr "{{#label}} debe ser anterior a {{:#limit}}"

# Label: date.max
#: date.max
msgid "{{#label}} must be less than or equal to {{:#limit}}"
msgstr "{{#label}} no puede ser posterior a {{:#limit}}"

# Label: date.min
#: date.min
msgid "{{#label}} must be greater than or equal to {{:#limit}}"
msgstr "{{#label}} no puede ser anterior a {{:#limit}}"

# Label: date.format.iso
#: date.format.iso
msgid "ISO 8601 date"
msgstr "una fecha en formato ISO 8601"

# Label: date.format.javascript
#: date.format.javascript
msgid "timestamp or number of milliseconds"
msgstr "una marca de tiempo en milisegundos"

# Label: date.format.unix
#: date.format.unix
msgid "timestamp or number of seconds"
msgstr "una marca de tiempo en segundos"

# Label: object.and
#: object.and
msgid ""
"{{#label}} contains {{#presentWithLabels}} without its required peers "
"{{#missingWithLabels}}"
msgstr ""
"{{#label}} contiene {{#presentWithLabels}}, pero también debe contener "
"{{#missingWithLabels}}"

# Label: object.assert
#: object.assert
msgid ""
"{{#label}} is invalid because {if(#subject.key, `\"` + #subject.key + `\" "
"failed to ` + (#message || \"pass the assertion test\"), #message || \"the "
"assertion failed\")}"
msgstr ""
"{{#label}} no cumple la condición requerida{if(#subject.key, ` para \"` + "
"#subject.key + `\"`, \"\")}{if(#message, \": \" + #message, \"\")}"

# Label: object.base
#: object.base
msgid "{{#label}} must be of type {{#type}}"
msgstr "{{#label}} debe ser del tipo {{#type}}"

# Label: object.instance
#: object.instance
msgid "{{#label}} must be an instance of {{:#type}}"
msgstr "{{#label}} debe ser una instancia de {{:#type}}"

# Label: object.length
#: object.length
msgid "{{#label}} must have {{#limit}} key{if(#limit == 1, \"\", \"s\")}"
msgstr ""
"{{#label}} debe contener exactamente {{#limit}} clave{if(#limit == 1, \"\", "
"\"s\")}"

# Label: object.max
#: object.max
msgid ""
"{{#label}} must have less than or equal to {{#limit}} key{if(#limit == 1, "
"\"\", \"s\")}"
msgstr ""
"{{#label}} debe contener como máximo {{#limit}} clave{if(#limit == 1, \"\", "
"\"s\")}"

# Label: object.min
#: object.min
msgid ""
"{{#label}} must have at least {{#limit}} key{if(#limit == 1, \"\", \"s\")}"
msgstr ""
"{{#label}} debe contener al menos {{#limit}} clave{if(#limit == 1, \"\", "
"\"s\")}"

# Label: object.missing
#: object.missing
msgid "{{#label}} must contain at least one of {{#peersWithLabels}}"
msgstr ""
"{{#label}} debe contener al menos una de las siguientes claves: "
"{{#peersWithLabels}}"

# Label: object.nand
#: object.nand
msgid ""
"{{:#mainWithLabel}} must not exist simultaneously with {{#peersWithLabels}}"
msgstr ""
"{{:#mainWithLabel}} no puede estar presente junto con todas las claves "
"siguientes: {{#peersWithLabels}}"

# Label: object.oxor
#: object.oxor
msgid ""
"{{#label}} contains a conflict between optional exclusive peers "
"{{#peersWithLabels}}"
msgstr ""
"{{#label}} debe contener como máximo una de las siguientes claves: "
"{{#peersWithLabels}}"

# Label: object.pattern.match
#: object.pattern.match
msgid "{{#label}} keys failed to match pattern requirements"
msgstr "Las claves de {{#label}} no cumplen los requisitos del patrón"

# Label: object.refType
#: object.refType
msgid "{{#label}} must be a Joi reference"
msgstr "{{#label}} debe ser una referencia de Joi"

# Label: object.regex
#: object.regex
msgid "{{#label}} must be a RegExp object"
msgstr "{{#label}} debe ser un objeto RegExp"

# Label: object.rename.multiple
#: object.rename.multiple
msgid ""
"{{#label}} cannot rename {{:#from}} because multiple renames are disabled "
"and another key was already renamed to {{:#to}}"
msgstr ""
"En {{#label}}, no se puede cambiar el nombre de {{:#from}} a {{:#to}} "
"porque ese nombre ya se ha asignado a otra clave"

# Label: object.rename.override
#: object.rename.override
msgid ""
"{{#label}} cannot rename {{:#from}} because override is disabled and target "
"{{:#to}} exists"
msgstr ""
"En {{#label}}, no se puede cambiar el nombre de {{:#from}} a {{:#to}} "
"porque ya existe una clave con ese nombre y no se permite sobrescribirla"

# Label: object.rename.proto
#: object.rename.proto
msgid ""
"{{#label}} cannot rename {{:#from}} because target {{:#to}} is a reserved key"
msgstr ""
"En {{#label}}, no se puede cambiar el nombre de {{:#from}} a {{:#to}} "
"porque el nombre de destino está reservado"

# Label: object.schema
#: object.schema
msgid "{{#label}} must be a Joi schema of {{#type}} type"
msgstr "{{#label}} debe ser un esquema de Joi del tipo {{#type}}"

# Label: object.with
#: object.with
msgid "{{:#mainWithLabel}} missing required peer {{:#peerWithLabel}}"
msgstr "{{:#mainWithLabel}} requiere que también esté presente {{:#peerWithLabel}}"

# Label: object.without
#: object.without
msgid "{{:#mainWithLabel}} conflict with forbidden peer {{:#peerWithLabel}}"
msgstr ""
"{{:#mainWithLabel}} no puede estar presente junto con {{:#peerWithLabel}}"

# Label: object.xor
#: object.xor
msgid ""
"{{#label}} contains a conflict between exclusive peers {{#peersWithLabels}}"
msgstr ""
"{{#label}} debe contener exactamente una de las siguientes claves: "
"{{#peersWithLabels}}"

# Label: function.arity
#: function.arity
msgid "{{#label}} must have an arity of {{#n}}"
msgstr ""
"{{#label}} debe tener exactamente {{#n}} parámetro{if(#n == 1, \"\", \"s\")}"

# Label: function.class
#: function.class
msgid "{{#label}} must be a class"
msgstr "{{#label}} debe ser una clase"

# Label: function.maxArity
#: function.maxArity
msgid "{{#label}} must have an arity lesser or equal to {{#n}}"
msgstr ""
"{{#label}} debe tener como máximo {{#n}} parámetro{if(#n == 1, \"\", \"s\")}"

# Label: function.minArity
#: function.minArity
msgid "{{#label}} must have an arity greater or equal to {{#n}}"
msgstr ""
"{{#label}} debe tener al menos {{#n}} parámetro{if(#n == 1, \"\", \"s\")}"

# Label: link.depth
#: link.depth
msgid "{{#label}} exceeds maximum recursion depth supported by the runtime"
msgstr ""
"{{#label}} supera la profundidad máxima de recursión admitida por el entorno "
"de ejecución"

# Label: link.maxRecursion
#: link.maxRecursion
msgid "{{#label}} exceeds maximum recursion depth of {{#limit}}"
msgstr "{{#label}} supera la profundidad máxima de recursión de {{#limit}}"

# Label: number.base
#: number.base
msgid "{{#label}} must be a number"
msgstr "{{#label}} debe ser un número"

# Label: number.greater
#: number.greater
msgid "{{#label}} must be greater than {{#limit}}"
msgstr "{{#label}} debe ser mayor que {{#limit}}"

# Label: number.infinity
#: number.infinity
msgid "{{#label}} cannot be infinity"
msgstr "{{#label}} no puede ser infinito"

# Label: number.integer
#: number.integer
msgid "{{#label}} must be an integer"
msgstr "{{#label}} debe ser un número entero"

# Label: number.less
#: number.less
msgid "{{#label}} must be less than {{#limit}}"
msgstr "{{#label}} debe ser menor que {{#limit}}"

# Label: number.max
#: number.max
msgid "{{#label}} must be less than or equal to {{#limit}}"
msgstr "{{#label}} no puede ser mayor que {{#limit}}"

# Label: number.min
#: number.min
msgid "{{#label}} must be greater than or equal to {{#limit}}"
msgstr "{{#label}} no puede ser menor que {{#limit}}"

# Label: number.multiple
#: number.multiple
msgid "{{#label}} must be a multiple of {{#multiple}}"
msgstr "{{#label}} debe ser múltiplo de {{#multiple}}"

# Label: number.negative
#: number.negative
msgid "{{#label}} must be a negative number"
msgstr "{{#label}} debe ser un número negativo"

# Label: number.port
#: number.port
msgid "{{#label}} must be a valid port"
msgstr "{{#label}} debe ser un número de puerto válido"

# Label: number.positive
#: number.positive
msgid "{{#label}} must be a positive number"
msgstr "{{#label}} debe ser un número positivo"

# Label: number.precision
#: number.precision
msgid "{{#label}} must have no more than {{#limit}} decimal places"
msgstr ""
"{{#label}} no puede tener más de {{#limit}} decimal{if(#limit == 1, \"\", "
"\"es\")}"

# Label: number.unsafe
#: number.unsafe
msgid "{{#label}} must be a safe number"
msgstr "{{#label}} excede los límites de precisión numérica de JavaScript"

# Label: string.alphanum
#: string.alphanum
msgid "{{#label}} must only contain alpha-numeric characters"
msgstr "{{#label}} solo puede contener letras (a-z, A-Z) y números (0-9)"

# Label: string.base
#: string.base
msgid "{{#label}} must be a string"
msgstr "{{#label}} debe ser una cadena de texto"

# Label: string.base64
#: string.base64
msgid "{{#label}} must be a valid base64 string"
msgstr "{{#label}} debe ser una cadena válida en Base64"

# Label: string.creditCard
#: string.creditCard
msgid "{{#label}} must be a credit card"
msgstr "{{#label}} debe ser un número de tarjeta de crédito válido"

# Label: string.dataUri
#: string.dataUri
msgid "{{#label}} must be a valid dataUri string"
msgstr "{{#label}} debe ser un URI de datos válido"

# Label: string.domain
#: string.domain
msgid "{{#label}} must contain a valid domain name"
msgstr "{{#label}} debe contener un nombre de dominio válido"

# Label: string.email
#: string.email
msgid "{{#label}} must be a valid email"
msgstr "{{#label}} debe ser una dirección de correo electrónico válida"

# Label: string.empty
#: string.empty
msgid "{{#label}} is not allowed to be empty"
msgstr "{{#label}} no puede estar vacío"

# Label: string.guid
#: string.guid
msgid "{{#label}} must be a valid GUID"
msgstr "{{#label}} debe ser un GUID válido"

# Label: string.hex
#: string.hex
msgid "{{#label}} must only contain hexadecimal characters"
msgstr "{{#label}} solo puede contener caracteres hexadecimales"

# Label: string.hexAlign
#: string.hexAlign
msgid "{{#label}} hex decoded representation must be byte aligned"
msgstr "{{#label}} debe contener un número par de caracteres hexadecimales"

# Label: string.hostname
#: string.hostname
msgid "{{#label}} must be a valid hostname"
msgstr "{{#label}} debe ser un nombre de host válido"

# Label: string.ip
#: string.ip
msgid "{{#label}} must be a valid ip address with a {{#cidr}} CIDR"
msgstr ""
"{{#label}} debe ser una dirección IP válida {{if(#cidr == \"required\", "
"\"con notación CIDR\", if(#cidr == \"optional\", \"con o sin notación "
"CIDR\", if(#cidr == \"forbidden\", \"sin notación CIDR\", #cidr)))}}"

# Label: string.ipVersion
#: string.ipVersion
msgid ""
"{{#label}} must be a valid ip address of one of the following versions "
"{{#version}} with a {{#cidr}} CIDR"
msgstr ""
"{{#label}} debe ser una dirección IP válida {{if(#cidr == \"required\", "
"\"con notación CIDR\", if(#cidr == \"optional\", \"con o sin notación "
"CIDR\", if(#cidr == \"forbidden\", \"sin notación CIDR\", #cidr)))}} "
"(versiones permitidas: {{#version}})"

# Label: string.isoDate
#: string.isoDate
msgid "{{#label}} must be in iso format"
msgstr "{{#label}} debe ser una fecha en formato ISO 8601"

# Label: string.isoDuration
#: string.isoDuration
msgid "{{#label}} must be a valid ISO 8601 duration"
msgstr "{{#label}} debe ser una duración válida en formato ISO 8601"

# Label: string.length
#: string.length
msgid "{{#label}} length must be {{#limit}} characters long"
msgstr ""
"{{#label}} debe contener exactamente {{#limit}} {if(#limit == 1, "
"\"carácter\", \"caracteres\")}"

# Label: string.lowercase
#: string.lowercase
msgid "{{#label}} must only contain lowercase characters"
msgstr "Todas las letras de {{#label}} deben estar en minúscula"

# Label: string.max
#: string.max
msgid ""
"{{#label}} length must be less than or equal to {{#limit}} characters long"
msgstr ""
"{{#label}} debe contener como máximo {{#limit}} {if(#limit == 1, "
"\"carácter\", \"caracteres\")}"

# Label: string.min
#: string.min
msgid "{{#label}} length must be at least {{#limit}} characters long"
msgstr ""
"{{#label}} debe contener al menos {{#limit}} {if(#limit == 1, \"carácter\", "
"\"caracteres\")}"

# Label: string.normalize
#: string.normalize
msgid "{{#label}} must be unicode normalized in the {{#form}} form"
msgstr "{{#label}} debe usar la forma de normalización Unicode {{#form}}"

# Label: string.token
#: string.token
msgid "{{#label}} must only contain alpha-numeric and underscore characters"
msgstr ""
"{{#label}} solo puede contener letras (a-z, A-Z), números (0-9) y guiones "
"bajos (_)"

# Label: string.pattern.base
#: string.pattern.base
msgid ""
"{{#label}} with value {:[.]} fails to match the required pattern: {{#regex}}"
msgstr ""
"{{#label}}, con el valor {:[.]}, no coincide con el patrón requerido: "
"{{#regex}}"

# Label: string.pattern.name
#: string.pattern.name
msgid "{{#label}} with value {:[.]} fails to match the {{#name}} pattern"
msgstr "{{#label}}, con el valor {:[.]}, no coincide con el patrón {{#name}}"

# Label: string.pattern.invert.base
#: string.pattern.invert.base
msgid "{{#label}} with value {:[.]} matches the inverted pattern: {{#regex}}"
msgstr ""
"{{#label}}, con el valor {:[.]}, coincide con el patrón no permitido: "
"{{#regex}}"

# Label: string.pattern.invert.name
#: string.pattern.invert.name
msgid "{{#label}} with value {:[.]} matches the inverted {{#name}} pattern"
msgstr ""
"{{#label}}, con el valor {:[.]}, coincide con el patrón no permitido "
"{{#name}}"

# Label: string.trim
#: string.trim
msgid "{{#label}} must not have leading or trailing whitespace"
msgstr "{{#label}} no puede tener espacios en blanco al principio ni al final"

# Label: string.uri
#: string.uri
msgid "{{#label}} must be a valid uri"
msgstr "{{#label}} debe ser un URI válido"

# Label: string.uriCustomScheme
#: string.uriCustomScheme
msgid ""
"{{#label}} must be a valid uri with a scheme matching the {{#scheme}} pattern"
msgstr ""
"{{#label}} debe ser un URI válido con un esquema que coincida con el patrón "
"{{#scheme}}"

# Label: string.uriRelativeOnly
#: string.uriRelativeOnly
msgid "{{#label}} must be a valid relative uri"
msgstr "{{#label}} debe ser un URI relativo válido"

# Label: string.uppercase
#: string.uppercase
msgid "{{#label}} must only contain uppercase characters"
msgstr "Todas las letras de {{#label}} deben estar en mayúscula"

# Label: symbol.base
#: symbol.base
msgid "{{#label}} must be a symbol"
msgstr "{{#label}} debe ser un valor de tipo Symbol"

# Label: symbol.map
#: symbol.map
msgid "{{#label}} must be one of {{#map}}"
msgstr "{{#label}} debe ser uno de los siguientes valores: {{#map}}"

# Label: binary.base
#: binary.base
msgid "{{#label}} must be a buffer or a string"
msgstr "{{#label}} debe ser un objeto Buffer o una cadena de texto"

# Label: binary.length
#: binary.length
msgid "{{#label}} must be {{#limit}} bytes"
msgstr ""
"{{#label}} debe tener exactamente {{#limit}} byte{if(#limit == 1, \"\", "
"\"s\")}"

# Label: binary.max
#: binary.max
msgid "{{#label}} must be less than or equal to {{#limit}} bytes"
msgstr ""
"{{#label}} debe tener como máximo {{#limit}} byte{if(#limit == 1, \"\", "
"\"s\")}"

# Label: binary.min
#: binary.min
msgid "{{#label}} must be at least {{#limit}} bytes"
msgstr ""
"{{#label}} debe tener al menos {{#limit}} byte{if(#limit == 1, \"\", \"s\")}"
