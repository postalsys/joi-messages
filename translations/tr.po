msgid ""
msgstr ""
"Project-Id-Version: \n"
"POT-Creation-Date: \n"
"PO-Revision-Date: \n"
"Last-Translator: \n"
"Language-Team: \n"
"Language: tr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# Label: any.custom
#: any.custom
msgid "{{#label}} failed custom validation because {{#error.message}}"
msgstr "{{#label}} özel doğrulamayı geçemedi: {{#error.message}}"

# Label: any.default
#: any.default
msgid "{{#label}} threw an error when running default method"
msgstr "{{#label}} için varsayılan değer hesaplanırken bir hata oluştu"

# Label: any.failover
#: any.failover
msgid "{{#label}} threw an error when running failover method"
msgstr "{{#label}} için yedek değer hesaplanırken bir hata oluştu"

# Label: any.invalid
#: any.invalid
msgid "{{#label}} contains an invalid value"
msgstr "{{#label}} geçersiz bir değer içeriyor"

# Label: any.only
#: any.only
msgid ""
"{{#label}} must be {if(#valids.length == 1, \"\", \"one of \")}{{#valids}}"
msgstr ""
"{{#label}} {if(#valids.length == 1, \"şu değere eşit olmalı\", \"şu "
"değerlerden biri olmalı\")}: {{#valids}}"

# Label: any.ref
#: any.ref
msgid "{{#label}} {{#arg}} references {{:#ref}} which {{#reason}}"
msgstr ""
"{{#label}}: {{#arg}} parametresinin {{:#ref}} başvurusu geçersiz: "
"{{#reason}}"

# Label: any.required
#: any.required
msgid "{{#label}} is required"
msgstr "{{#label}} zorunlu"

# Label: object.unknown
#: object.unknown
msgid "{{#label}} is not allowed"
msgstr "{{#label}} alanına izin verilmiyor"

# Label: alternatives.all
#: alternatives.all
msgid "{{#label}} does not match all of the required types"
msgstr "{{#label}} gerekli türlerin tümüne uymuyor"

# Label: array.includes
#: array.includes
msgid "{{#label}} does not match any of the allowed types"
msgstr "{{#label}} izin verilen türlerden hiçbirine uymuyor"

# Label: alternatives.one
#: alternatives.one
msgid "{{#label}} matches more than one allowed type"
msgstr "{{#label}} izin verilen türlerden birden fazlasına uyuyor"

# Label: alternatives.types
#: alternatives.types
msgid "{{#label}} must be one of {{#types}}"
msgstr "{{#label}} şu türlerden biri olmalı: {{#types}}"

# Label: array.base
#: array.base
msgid "{{#label}} must be an array"
msgstr "{{#label}} bir dizi olmalı"

# Label: array.excludes
#: array.excludes
msgid "{{#label}} contains an excluded value"
msgstr "{{#label}} izin verilmeyen bir değer içeriyor"

# Label: array.hasKnown
#: array.hasKnown
msgid ""
"{{#label}} does not contain at least one required match for type "
"{:#patternLabel}"
msgstr ""
"{{#label}}, {:#patternLabel} için gereken koşulları sağlayan en az bir öğe "
"içermeli"

# Label: array.hasUnknown
#: array.hasUnknown
msgid "{{#label}} does not contain at least one required match"
msgstr "{{#label}} belirtilen koşulu sağlayan en az bir öğe içermeli"

# Label: array.includesRequiredBoth
#: array.includesRequiredBoth
msgid ""
"{{#label}} does not contain {{#knownMisses}} and {{#unknownMisses}} other "
"required value(s)"
msgstr ""
"{{#label}} içinde {{#knownMisses}} ve {{#unknownMisses}} zorunlu değer daha "
"eksik"

# Label: array.includesRequiredKnowns
#: array.includesRequiredKnowns
msgid "{{#label}} does not contain {{#knownMisses}}"
msgstr "{{#label}} içinde şu değerler eksik: {{#knownMisses}}"

# Label: array.includesRequiredUnknowns
#: array.includesRequiredUnknowns
msgid "{{#label}} does not contain {{#unknownMisses}} required value(s)"
msgstr "{{#label}} içinde {{#unknownMisses}} zorunlu değer eksik"

# Label: array.length
#: array.length
msgid "{{#label}} must contain {{#limit}} items"
msgstr "{{#label}} tam olarak {{#limit}} öğe içermeli"

# Label: array.max
#: array.max
msgid "{{#label}} must contain less than or equal to {{#limit}} items"
msgstr "{{#label}} en fazla {{#limit}} öğe içerebilir"

# Label: array.min
#: array.min
msgid "{{#label}} must contain at least {{#limit}} items"
msgstr "{{#label}} en az {{#limit}} öğe içermeli"

# Label: array.orderedLength
#: array.orderedLength
msgid "{{#label}} must contain at most {{#limit}} items"
msgstr "{{#label}} en fazla {{#limit}} öğe içerebilir"

# Label: array.sort
#: array.sort
msgid "{{#label}} must be sorted in {#order} order by {{#by}}"
msgstr ""
"{{#label}}, {{#by}} ölçütüne göre {if(#order == \"ascending\", \"artan\", "
"if(#order == \"descending\", \"azalan\", #order))} sırada olmalı"

# Label: array.sort.mismatching
#: array.sort.mismatching
msgid "{{#label}} cannot be sorted due to mismatching types"
msgstr "{{#label}}, farklı türde değerler içerdiği için sıralanamıyor"

# Label: array.sort.unsupported
#: array.sort.unsupported
msgid "{{#label}} cannot be sorted due to unsupported type {#type}"
msgstr "{{#label}}, {#type} türü desteklenmediği için sıralanamıyor"

# Label: array.sparse
#: array.sparse
msgid "{{#label}} must not be a sparse array item"
msgstr "{{#label}} undefined olamaz"

# Label: array.unique
#: array.unique
msgid "{{#label}} contains a duplicate value"
msgstr "{{#label}} yinelenen bir değer içeriyor"

# Label: boolean.base
#: boolean.base
msgid "{{#label}} must be a boolean"
msgstr "{{#label}} bir boole değeri (true veya false) olmalı"

# Label: date.base
#: date.base
msgid "{{#label}} must be a valid date"
msgstr "{{#label}} geçerli bir tarih olmalı"

# Label: date.format
#: date.format
msgid ""
"{{#label}} must be in {msg(\"date.format.\" + #format) || #format} format"
msgstr "{{#label}} {msg(\"date.format.\" + #format) || #format} olmalı"

# Label: date.greater
#: date.greater
msgid "{{#label}} must be greater than {{:#limit}}"
msgstr "{{#label}} {{:#limit}} tarihinden sonra olmalı"

# Label: date.less
#: date.less
msgid "{{#label}} must be less than {{:#limit}}"
msgstr "{{#label}} {{:#limit}} tarihinden önce olmalı"

# Label: date.max
#: date.max
msgid "{{#label}} must be less than or equal to {{:#limit}}"
msgstr "{{#label}} {{:#limit}} tarihinden sonra olamaz"

# Label: date.min
#: date.min
msgid "{{#label}} must be greater than or equal to {{:#limit}}"
msgstr "{{#label}} {{:#limit}} tarihinden önce olamaz"

# Label: date.format.iso
#: date.format.iso
msgid "ISO 8601 date"
msgstr "ISO 8601 biçiminde bir tarih"

# Label: date.format.javascript
#: date.format.javascript
msgid "timestamp or number of milliseconds"
msgstr "milisaniye cinsinden bir zaman damgası"

# Label: date.format.unix
#: date.format.unix
msgid "timestamp or number of seconds"
msgstr "saniye cinsinden bir zaman damgası"

# Label: object.and
#: object.and
msgid ""
"{{#label}} contains {{#presentWithLabels}} without its required peers "
"{{#missingWithLabels}}"
msgstr ""
"{{#label}} içinde {{#presentWithLabels}} ile birlikte "
"{{#missingWithLabels}} bulunmalı"

# Label: object.assert
#: object.assert
msgid ""
"{{#label}} is invalid because {if(#subject.key, `\"` + #subject.key + `\" "
"failed to ` + (#message || \"pass the assertion test\"), #message || \"the "
"assertion failed\")}"
msgstr ""
"{{#label}} için gereken koşul sağlanmıyor{if(#subject.key, ` (\"` + "
"#subject.key + `\")`, \"\")}{if(#message, \": \" + #message, \"\")}"

# Label: object.base
#: object.base
msgid "{{#label}} must be of type {{#type}}"
msgstr "{{#label}} {{#type}} türünde olmalı"

# Label: object.instance
#: object.instance
msgid "{{#label}} must be an instance of {{:#type}}"
msgstr "{{#label}} {{:#type}} sınıfının bir örneği olmalı"

# Label: object.length
#: object.length
msgid "{{#label}} must have {{#limit}} key{if(#limit == 1, \"\", \"s\")}"
msgstr "{{#label}} tam olarak {{#limit}} anahtar içermeli"

# Label: object.max
#: object.max
msgid ""
"{{#label}} must have less than or equal to {{#limit}} key{if(#limit == 1, "
"\"\", \"s\")}"
msgstr "{{#label}} en fazla {{#limit}} anahtar içerebilir"

# Label: object.min
#: object.min
msgid ""
"{{#label}} must have at least {{#limit}} key{if(#limit == 1, \"\", \"s\")}"
msgstr "{{#label}} en az {{#limit}} anahtar içermeli"

# Label: object.missing
#: object.missing
msgid "{{#label}} must contain at least one of {{#peersWithLabels}}"
msgstr "{{#label}} şu anahtarlardan en az birini içermeli: {{#peersWithLabels}}"

# Label: object.nand
#: object.nand
msgid ""
"{{:#mainWithLabel}} must not exist simultaneously with {{#peersWithLabels}}"
msgstr ""
"{{:#mainWithLabel}} şu anahtarların tümüyle birlikte bulunamaz: "
"{{#peersWithLabels}}"

# Label: object.oxor
#: object.oxor
msgid ""
"{{#label}} contains a conflict between optional exclusive peers "
"{{#peersWithLabels}}"
msgstr ""
"{{#label}} şu anahtarlardan en fazla birini içerebilir: {{#peersWithLabels}}"

# Label: object.pattern.match
#: object.pattern.match
msgid "{{#label}} keys failed to match pattern requirements"
msgstr "{{#label}} içindeki anahtarlar desen için belirlenen koşulları sağlamıyor"

# Label: object.refType
#: object.refType
msgid "{{#label}} must be a Joi reference"
msgstr "{{#label}} bir Joi başvurusu olmalı"

# Label: object.regex
#: object.regex
msgid "{{#label}} must be a RegExp object"
msgstr "{{#label}} bir RegExp nesnesi olmalı"

# Label: object.rename.multiple
#: object.rename.multiple
msgid ""
"{{#label}} cannot rename {{:#from}} because multiple renames are disabled "
"and another key was already renamed to {{:#to}}"
msgstr ""
"{{#label}}: {{:#from}} anahtarının adı {{:#to}} olarak değiştirilemez; "
"başka bir anahtara zaten bu ad verilmiş"

# Label: object.rename.override
#: object.rename.override
msgid ""
"{{#label}} cannot rename {{:#from}} because override is disabled and target "
"{{:#to}} exists"
msgstr ""
"{{#label}}: {{:#from}} anahtarının adı {{:#to}} olarak değiştirilemez; bu "
"adla bir anahtar zaten var ve üzerine yazılmasına izin verilmiyor"

# Label: object.rename.proto
#: object.rename.proto
msgid ""
"{{#label}} cannot rename {{:#from}} because target {{:#to}} is a reserved key"
msgstr ""
"{{#label}}: {{:#from}} anahtarının adı {{:#to}} olarak değiştirilemez; "
"bu ad özel kullanım için ayrılmış"

# Label: object.schema
#: object.schema
msgid "{{#label}} must be a Joi schema of {{#type}} type"
msgstr "{{#label}} {{#type}} türünde bir Joi şeması olmalı"

# Label: object.with
#: object.with
msgid "{{:#mainWithLabel}} missing required peer {{:#peerWithLabel}}"
msgstr "{{:#mainWithLabel}} varsa {{:#peerWithLabel}} alanı da bulunmalı"

# Label: object.without
#: object.without
msgid "{{:#mainWithLabel}} conflict with forbidden peer {{:#peerWithLabel}}"
msgstr "{{:#mainWithLabel}} ile {{:#peerWithLabel}} birlikte bulunamaz"

# Label: object.xor
#: object.xor
msgid ""
"{{#label}} contains a conflict between exclusive peers {{#peersWithLabels}}"
msgstr "{{#label}} şu anahtarlardan tam olarak birini içermeli: {{#peersWithLabels}}"

# Label: function.arity
#: function.arity
msgid "{{#label}} must have an arity of {{#n}}"
msgstr "{{#label}} için parametre sayısı tam olarak {{#n}} olmalı"

# Label: function.class
#: function.class
msgid "{{#label}} must be a class"
msgstr "{{#label}} bir sınıf olmalı"

# Label: function.maxArity
#: function.maxArity
msgid "{{#label}} must have an arity lesser or equal to {{#n}}"
msgstr "{{#label}} için parametre sayısı en fazla {{#n}} olmalı"

# Label: function.minArity
#: function.minArity
msgid "{{#label}} must have an arity greater or equal to {{#n}}"
msgstr "{{#label}} için parametre sayısı en az {{#n}} olmalı"

# Label: link.depth
#: link.depth
msgid "{{#label}} exceeds maximum recursion depth supported by the runtime"
msgstr ""
"{{#label}}, çalışma ortamının desteklediği özyineleme derinliği sınırını "
"aşıyor"

# Label: link.maxRecursion
#: link.maxRecursion
msgid "{{#label}} exceeds maximum recursion depth of {{#limit}}"
msgstr "{{#label}}, izin verilen {{#limit}} özyineleme derinliğini aşıyor"

# Label: number.base
#: number.base
msgid "{{#label}} must be a number"
msgstr "{{#label}} bir sayı olmalı"

# Label: number.greater
#: number.greater
msgid "{{#label}} must be greater than {{#limit}}"
msgstr "{{#label}} {{#limit}} değerinden büyük olmalı"

# Label: number.infinity
#: number.infinity
msgid "{{#label}} cannot be infinity"
msgstr "{{#label}} sonsuz olamaz"

# Label: number.integer
#: number.integer
msgid "{{#label}} must be an integer"
msgstr "{{#label}} bir tam sayı olmalı"

# Label: number.less
#: number.less
msgid "{{#label}} must be less than {{#limit}}"
msgstr "{{#label}} {{#limit}} değerinden küçük olmalı"

# Label: number.max
#: number.max
msgid "{{#label}} must be less than or equal to {{#limit}}"
msgstr "{{#label}} en fazla {{#limit}} olabilir"

# Label: number.min
#: number.min
msgid "{{#label}} must be greater than or equal to {{#limit}}"
msgstr "{{#label}} en az {{#limit}} olmalı"

# Label: number.multiple
#: number.multiple
msgid "{{#label}} must be a multiple of {{#multiple}}"
msgstr "{{#label}} {{#multiple}} sayısının katı olmalı"

# Label: number.negative
#: number.negative
msgid "{{#label}} must be a negative number"
msgstr "{{#label}} negatif bir sayı olmalı"

# Label: number.port
#: number.port
msgid "{{#label}} must be a valid port"
msgstr "{{#label}} geçerli bir bağlantı noktası numarası olmalı"

# Label: number.positive
#: number.positive
msgid "{{#label}} must be a positive number"
msgstr "{{#label}} pozitif bir sayı olmalı"

# Label: number.precision
#: number.precision
msgid "{{#label}} must have no more than {{#limit}} decimal places"
msgstr "{{#label}} virgülden sonra en fazla {{#limit}} basamak içerebilir"

# Label: number.unsafe
#: number.unsafe
msgid "{{#label}} must be a safe number"
msgstr "{{#label}}, JavaScript'in sayısal hassasiyet sınırlarını aşıyor"

# Label: string.alphanum
#: string.alphanum
msgid "{{#label}} must only contain alpha-numeric characters"
msgstr "{{#label}} yalnızca harf (a-z, A-Z) ve rakam (0-9) içerebilir"

# Label: string.base
#: string.base
msgid "{{#label}} must be a string"
msgstr "{{#label}} bir metin dizesi olmalı"

# Label: string.base64
#: string.base64
msgid "{{#label}} must be a valid base64 string"
msgstr "{{#label}} geçerli bir Base64 dizesi olmalı"

# Label: string.creditCard
#: string.creditCard
msgid "{{#label}} must be a credit card"
msgstr "{{#label}} geçerli bir kredi kartı numarası olmalı"

# Label: string.dataUri
#: string.dataUri
msgid "{{#label}} must be a valid dataUri string"
msgstr "{{#label}} geçerli bir veri URI'si olmalı"

# Label: string.domain
#: string.domain
msgid "{{#label}} must contain a valid domain name"
msgstr "{{#label}} geçerli bir alan adı içermeli"

# Label: string.email
#: string.email
msgid "{{#label}} must be a valid email"
msgstr "{{#label}} geçerli bir e-posta adresi olmalı"

# Label: string.empty
#: string.empty
msgid "{{#label}} is not allowed to be empty"
msgstr "{{#label}} boş olamaz"

# Label: string.guid
#: string.guid
msgid "{{#label}} must be a valid GUID"
msgstr "{{#label}} geçerli bir GUID olmalı"

# Label: string.hex
#: string.hex
msgid "{{#label}} must only contain hexadecimal characters"
msgstr "{{#label}} yalnızca onaltılık basamaklar (0-9, a-f, A-F) içerebilir"

# Label: string.hexAlign
#: string.hexAlign
msgid "{{#label}} hex decoded representation must be byte aligned"
msgstr "{{#label}} çift sayıda onaltılık basamak içermeli"

# Label: string.hostname
#: string.hostname
msgid "{{#label}} must be a valid hostname"
msgstr "{{#label}} geçerli bir ana makine adı olmalı"

# Label: string.ip
#: string.ip
msgid "{{#label}} must be a valid ip address with a {{#cidr}} CIDR"
msgstr ""
"{{#label}} geçerli bir IP adresi olmalı (CIDR gösterimi: {{if(#cidr == "
"\"required\", \"gerekli\", if(#cidr == \"optional\", \"isteğe bağlı\", "
"if(#cidr == \"forbidden\", \"kullanılamaz\", #cidr)))}})"

# Label: string.ipVersion
#: string.ipVersion
msgid ""
"{{#label}} must be a valid ip address of one of the following versions "
"{{#version}} with a {{#cidr}} CIDR"
msgstr ""
"{{#label}} şu sürümlerden birinde geçerli bir IP adresi olmalı: "
"{{#version}} (CIDR gösterimi: {{if(#cidr == \"required\", \"gerekli\", "
"if(#cidr == \"optional\", \"isteğe bağlı\", if(#cidr == \"forbidden\", "
"\"kullanılamaz\", #cidr)))}})"

# Label: string.isoDate
#: string.isoDate
msgid "{{#label}} must be in iso format"
msgstr "{{#label}} ISO 8601 biçiminde bir tarih olmalı"

# Label: string.isoDuration
#: string.isoDuration
msgid "{{#label}} must be a valid ISO 8601 duration"
msgstr "{{#label}} ISO 8601 biçiminde geçerli bir süre olmalı"

# Label: string.length
#: string.length
msgid "{{#label}} length must be {{#limit}} characters long"
msgstr "{{#label}} tam olarak {{#limit}} karakter içermeli"

# Label: string.lowercase
#: string.lowercase
msgid "{{#label}} must only contain lowercase characters"
msgstr "{{#label}} içindeki harfler küçük harfle yazılmalı"

# Label: string.max
#: string.max
msgid ""
"{{#label}} length must be less than or equal to {{#limit}} characters long"
msgstr "{{#label}} en fazla {{#limit}} karakter içerebilir"

# Label: string.min
#: string.min
msgid "{{#label}} length must be at least {{#limit}} characters long"
msgstr "{{#label}} en az {{#limit}} karakter içermeli"

# Label: string.normalize
#: string.normalize
msgid "{{#label}} must be unicode normalized in the {{#form}} form"
msgstr "{{#label}}, Unicode {{#form}} biçiminde normalleştirilmiş olmalı"

# Label: string.token
#: string.token
msgid "{{#label}} must only contain alpha-numeric and underscore characters"
msgstr ""
"{{#label}} yalnızca harf (a-z, A-Z), rakam (0-9) ve alt çizgi (_) içerebilir"

# Label: string.pattern.base
#: string.pattern.base
msgid ""
"{{#label}} with value {:[.]} fails to match the required pattern: {{#regex}}"
msgstr "{{#label}} için {:[.]} değeri gerekli desenle eşleşmiyor: {{#regex}}"

# Label: string.pattern.name
#: string.pattern.name
msgid "{{#label}} with value {:[.]} fails to match the {{#name}} pattern"
msgstr "{{#label}} için {:[.]} değeri {{#name}} deseniyle eşleşmiyor"

# Label: string.pattern.invert.base
#: string.pattern.invert.base
msgid "{{#label}} with value {:[.]} matches the inverted pattern: {{#regex}}"
msgstr "{{#label}} için {:[.]} değeri izin verilmeyen desenle eşleşiyor: {{#regex}}"

# Label: string.pattern.invert.name
#: string.pattern.invert.name
msgid "{{#label}} with value {:[.]} matches the inverted {{#name}} pattern"
msgstr "{{#label}} için {:[.]} değeri izin verilmeyen {{#name}} deseniyle eşleşiyor"

# Label: string.trim
#: string.trim
msgid "{{#label}} must not have leading or trailing whitespace"
msgstr "{{#label}} başında veya sonunda boşluk karakteri içeremez"

# Label: string.uri
#: string.uri
msgid "{{#label}} must be a valid uri"
msgstr "{{#label}} geçerli bir URI olmalı"

# Label: string.uriCustomScheme
#: string.uriCustomScheme
msgid ""
"{{#label}} must be a valid uri with a scheme matching the {{#scheme}} pattern"
msgstr "{{#label}} geçerli bir URI olmalı ve şeması {{#scheme}} desenine uymalı"

# Label: string.uriRelativeOnly
#: string.uriRelativeOnly
msgid "{{#label}} must be a valid relative uri"
msgstr "{{#label}} geçerli bir göreli URI olmalı"

# Label: string.uppercase
#: string.uppercase
msgid "{{#label}} must only contain uppercase characters"
msgstr "{{#label}} içindeki harfler büyük harfle yazılmalı"

# Label: symbol.base
#: symbol.base
msgid "{{#label}} must be a symbol"
msgstr "{{#label}} Symbol türünde bir değer olmalı"

# Label: symbol.map
#: symbol.map
msgid "{{#label}} must be one of {{#map}}"
msgstr "{{#label}} şu değerlerden biri olmalı: {{#map}}"

# Label: binary.base
#: binary.base
msgid "{{#label}} must be a buffer or a string"
msgstr "{{#label}} bir Buffer nesnesi veya metin dizesi olmalı"

# Label: binary.length
#: binary.length
msgid "{{#label}} must be {{#limit}} bytes"
msgstr "{{#label}} tam olarak {{#limit}} bayt uzunluğunda olmalı"

# Label: binary.max
#: binary.max
msgid "{{#label}} must be less than or equal to {{#limit}} bytes"
msgstr "{{#label}} en fazla {{#limit}} bayt uzunluğunda olabilir"

# Label: binary.min
#: binary.min
msgid "{{#label}} must be at least {{#limit}} bytes"
msgstr "{{#label}} en az {{#limit}} bayt uzunluğunda olmalı"
