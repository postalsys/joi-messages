msgid ""
msgstr ""
"Project-Id-Version: \n"
"POT-Creation-Date: \n"
"PO-Revision-Date: \n"
"Last-Translator: \n"
"Language-Team: \n"
"Language: it\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# Label: any.custom
#: any.custom
msgid "{{#label}} failed custom validation because {{#error.message}}"
msgstr ""
"{{#label}} non ha superato la validazione personalizzata: {{#error.message}}"

# Label: any.default
#: any.default
msgid "{{#label}} threw an error when running default method"
msgstr ""
"Si è verificato un errore durante il calcolo del valore predefinito di "
"{{#label}}"

# Label: any.failover
#: any.failover
msgid "{{#label}} threw an error when running failover method"
msgstr ""
"Si è verificato un errore durante il calcolo del valore di riserva di "
"{{#label}}"

# Label: any.invalid
#: any.invalid
msgid "{{#label}} contains an invalid value"
msgstr "{{#label}} contiene un valore non valido"

# Label: any.only
#: any.only
msgid ""
"{{#label}} must be {if(#valids.length == 1, \"\", \"one of \")}{{#valids}}"
msgstr ""
"{{#label}} deve essere {if(#valids.length == 1, \"\", \"uno dei seguenti "
"valori: \")}{{#valids}}"

# Label: any.ref
#: any.ref
msgid "{{#label}} {{#arg}} references {{:#ref}} which {{#reason}}"
msgstr "{{#label}}: l'argomento {{#arg}} fa riferimento a {{:#ref}}: {{#reason}}"

# Label: any.required
#: any.required
msgid "{{#label}} is required"
msgstr "{{#label}} è obbligatorio"

# Label: object.unknown
#: object.unknown
msgid "{{#label}} is not allowed"
msgstr "{{#label}} non è consentito"

# Label: alternatives.all
#: alternatives.all
msgid "{{#label}} does not match all of the required types"
msgstr "{{#label}} non soddisfa i requisiti di tutti i tipi indicati"

# Label: array.includes
#: array.includes
msgid "{{#label}} does not match any of the allowed types"
msgstr "{{#label}} non corrisponde a nessuno dei tipi consentiti"

# Label: alternatives.one
#: alternatives.one
msgid "{{#label}} matches more than one allowed type"
msgstr "{{#label}} corrisponde a più di un tipo consentito"

# Label: alternatives.types
#: alternatives.types
msgid "{{#label}} must be one of {{#types}}"
msgstr "{{#label}} deve essere di uno dei seguenti tipi: {{#types}}"

# Label: array.base
#: array.base
msgid "{{#label}} must be an array"
msgstr "{{#label}} deve essere un array"

# Label: array.excludes
#: array.excludes
msgid "{{#label}} contains an excluded value"
msgstr "{{#label}} contiene un valore non consentito"

# Label: array.hasKnown
#: array.hasKnown
msgid ""
"{{#label}} does not contain at least one required match for type "
"{:#patternLabel}"
msgstr ""
"{{#label}} deve contenere almeno un elemento che soddisfi i requisiti di "
"{:#patternLabel}"

# Label: array.hasUnknown
#: array.hasUnknown
msgid "{{#label}} does not contain at least one required match"
msgstr ""
"{{#label}} deve contenere almeno un elemento che soddisfi la condizione "
"richiesta"

# Label: array.includesRequiredBoth
#: array.includesRequiredBoth
msgid ""
"{{#label}} does not contain {{#knownMisses}} and {{#unknownMisses}} other "
"required value(s)"
msgstr ""
"In {{#label}} mancano {{#knownMisses}} e {{#unknownMisses}} "
"{if(#unknownMisses == 1, \"altro valore richiesto\", \"altri valori "
"richiesti\")}"

# Label: array.includesRequiredKnowns
#: array.includesRequiredKnowns
msgid "{{#label}} does not contain {{#knownMisses}}"
msgstr "{{#label}} non contiene {{#knownMisses}}"

# Label: array.includesRequiredUnknowns
#: array.includesRequiredUnknowns
msgid "{{#label}} does not contain {{#unknownMisses}} required value(s)"
msgstr ""
"In {{#label}} {if(#unknownMisses == 1, \"manca\", \"mancano\")} "
"{{#unknownMisses}} {if(#unknownMisses == 1, \"valore richiesto\", \"valori "
"richiesti\")}"

# Label: array.length
#: array.length
msgid "{{#label}} must contain {{#limit}} items"
msgstr ""
"{{#label}} deve contenere esattamente {{#limit}} {if(#limit == 1, "
"\"elemento\", \"elementi\")}"

# Label: array.max
#: array.max
msgid "{{#label}} must contain less than or equal to {{#limit}} items"
msgstr ""
"{{#label}} deve contenere al massimo {{#limit}} {if(#limit == 1, "
"\"elemento\", \"elementi\")}"

# Label: array.min
#: array.min
msgid "{{#label}} must contain at least {{#limit}} items"
msgstr ""
"{{#label}} deve contenere almeno {{#limit}} {if(#limit == 1, \"elemento\", "
"\"elementi\")}"

# Label: array.orderedLength
#: array.orderedLength
msgid "{{#label}} must contain at most {{#limit}} items"
msgstr ""
"{{#label}} deve contenere al massimo {{#limit}} {if(#limit == 1, "
"\"elemento\", \"elementi\")}"

# Label: array.sort
#: array.sort
msgid "{{#label}} must be sorted in {#order} order by {{#by}}"
msgstr ""
"{{#label}} deve essere ordinato per {{#by}} in ordine {if(#order == "
"\"ascending\", \"crescente\", if(#order == \"descending\", \"decrescente\", "
"#order))}"

# Label: array.sort.mismatching
#: array.sort.mismatching
msgid "{{#label}} cannot be sorted due to mismatching types"
msgstr "{{#label}} non può essere ordinato perché i valori hanno tipi diversi"

# Label: array.sort.unsupported
#: array.sort.unsupported
msgid "{{#label}} cannot be sorted due to unsupported type {#type}"
msgstr ""
"{{#label}} non può essere ordinato perché il tipo {#type} non è supportato"

# Label: array.sparse
#: array.sparse
msgid "{{#label}} must not be a sparse array item"
msgstr "{{#label}} non può essere undefined"

# Label: array.unique
#: array.unique
msgid "{{#label}} contains a duplicate value"
msgstr "{{#label}} contiene un valore duplicato"

# Label: boolean.base
#: boolean.base
msgid "{{#label}} must be a boolean"
msgstr "{{#label}} deve essere un valore booleano (true o false)"

# Label: date.base
#: date.base
msgid "{{#label}} must be a valid date"
msgstr "{{#label}} deve essere una data valida"

# Label: date.format
#: date.format
msgid ""
"{{#label}} must be in {msg(\"date.format.\" + #format) || #format} format"
msgstr "{{#label}} deve essere {msg(\"date.format.\" + #format) || #format}"

# Label: date.greater
#: date.greater
msgid "{{#label}} must be greater than {{:#limit}}"
msgstr "{{#label}} deve essere una data successiva a {{:#limit}}"

# Label: date.less
#: date.less
msgid "{{#label}} must be less than {{:#limit}}"
msgstr "{{#label}} deve essere una data precedente a {{:#limit}}"

# Label: date.max
#: date.max
msgid "{{#label}} must be less than or equal to {{:#limit}}"
msgstr "La data in {{#label}} non può essere successiva a {{:#limit}}"

# Label: date.min
#: date.min
msgid "{{#label}} must be greater than or equal to {{:#limit}}"
msgstr "La data in {{#label}} non può essere precedente a {{:#limit}}"

# Label: date.format.iso
#: date.format.iso
msgid "ISO 8601 date"
msgstr "una data in formato ISO 8601"

# Label: date.format.javascript
#: date.format.javascript
msgid "timestamp or number of milliseconds"
msgstr "un timestamp in millisecondi"

# Label: date.format.unix
#: date.format.unix
msgid "timestamp or number of seconds"
msgstr "un timestamp in secondi"

# Label: object.and
#: object.and
msgid ""
"{{#label}} contains {{#presentWithLabels}} without its required peers "
"{{#missingWithLabels}}"
msgstr ""
"{{#label}} contiene {{#presentWithLabels}}, ma deve contenere anche "
"{{#missingWithLabels}}"

# Label: object.assert
#: object.assert
msgid ""
"{{#label}} is invalid because {if(#subject.key, `\"` + #subject.key + `\" "
"failed to ` + (#message || \"pass the assertion test\"), #message || \"the "
"assertion failed\")}"
msgstr ""
"{{#label}} non soddisfa la condizione richiesta{if(#subject.key, ` per \"` "
"+ #subject.key + `\"`, \"\")}{if(#message, \": \" + #message, \"\")}"

# Label: object.base
#: object.base
msgid "{{#label}} must be of type {{#type}}"
msgstr "{{#label}} deve essere di tipo {{#type}}"

# Label: object.instance
#: object.instance
msgid "{{#label}} must be an instance of {{:#type}}"
msgstr "{{#label}} deve essere un'istanza di {{:#type}}"

# Label: object.length
#: object.length
msgid "{{#label}} must have {{#limit}} key{if(#limit == 1, \"\", \"s\")}"
msgstr ""
"{{#label}} deve contenere esattamente {{#limit}} {if(#limit == 1, "
"\"chiave\", \"chiavi\")}"

# Label: object.max
#: object.max
msgid ""
"{{#label}} must have less than or equal to {{#limit}} key{if(#limit == 1, "
"\"\", \"s\")}"
msgstr ""
"{{#label}} deve contenere al massimo {{#limit}} {if(#limit == 1, \"chiave\", "
"\"chiavi\")}"

# Label: object.min
#: object.min
msgid ""
"{{#label}} must have at least {{#limit}} key{if(#limit == 1, \"\", \"s\")}"
msgstr ""
"{{#label}} deve contenere almeno {{#limit}} {if(#limit == 1, \"chiave\", "
"\"chiavi\")}"

# Label: object.missing
#: object.missing
msgid "{{#label}} must contain at least one of {{#peersWithLabels}}"
msgstr ""
"{{#label}} deve contenere almeno una delle seguenti chiavi: "
"{{#peersWithLabels}}"

# Label: object.nand
#: object.nand
msgid ""
"{{:#mainWithLabel}} must not exist simultaneously with {{#peersWithLabels}}"
msgstr ""
"{{:#mainWithLabel}} non può essere presente insieme a tutte le chiavi "
"seguenti: {{#peersWithLabels}}"

# Label: object.oxor
#: object.oxor
msgid ""
"{{#label}} contains a conflict between optional exclusive peers "
"{{#peersWithLabels}}"
msgstr ""
"{{#label}} deve contenere al massimo una delle seguenti chiavi: "
"{{#peersWithLabels}}"

# Label: object.pattern.match
#: object.pattern.match
msgid "{{#label}} keys failed to match pattern requirements"
msgstr "Le chiavi di {{#label}} non soddisfano i requisiti del pattern"

# Label: object.refType
#: object.refType
msgid "{{#label}} must be a Joi reference"
msgstr "{{#label}} deve essere un riferimento Joi"

# Label: object.regex
#: object.regex
msgid "{{#label}} must be a RegExp object"
msgstr "{{#label}} deve essere un oggetto RegExp"

# Label: object.rename.multiple
#: object.rename.multiple
msgid ""
"{{#label}} cannot rename {{:#from}} because multiple renames are disabled "
"and another key was already renamed to {{:#to}}"
msgstr ""
"In {{#label}}, non è possibile rinominare {{:#from}} in {{:#to}} perché "
"un'altra chiave è già stata rinominata così"

# Label: object.rename.override
#: object.rename.override
msgid ""
"{{#label}} cannot rename {{:#from}} because override is disabled and target "
"{{:#to}} exists"
msgstr ""
"In {{#label}}, non è possibile rinominare {{:#from}} in {{:#to}} perché "
"esiste già una chiave con quel nome e non è consentito sovrascriverla"

# Label: object.rename.proto
#: object.rename.proto
msgid ""
"{{#label}} cannot rename {{:#from}} because target {{:#to}} is a reserved key"
msgstr ""
"In {{#label}}, non è possibile rinominare {{:#from}} in {{:#to}} perché il "
"nome di destinazione è riservato"

# Label: object.schema
#: object.schema
msgid "{{#label}} must be a Joi schema of {{#type}} type"
msgstr "{{#label}} deve essere uno schema Joi di tipo {{#type}}"

# Label: object.with
#: object.with
msgid "{{:#mainWithLabel}} missing required peer {{:#peerWithLabel}}"
msgstr "{{:#mainWithLabel}} richiede anche {{:#peerWithLabel}}"

# Label: object.without
#: object.without
msgid "{{:#mainWithLabel}} conflict with forbidden peer {{:#peerWithLabel}}"
msgstr ""
"{{:#mainWithLabel}} non può essere presente insieme a {{:#peerWithLabel}}"

# Label: object.xor
#: object.xor
msgid ""
"{{#label}} contains a conflict between exclusive peers {{#peersWithLabels}}"
msgstr ""
"{{#label}} deve contenere esattamente una delle seguenti chiavi: "
"{{#peersWithLabels}}"

# Label: function.arity
#: function.arity
msgid "{{#label}} must have an arity of {{#n}}"
msgstr ""
"{{#label}} deve avere esattamente {{#n}} {if(#n == 1, \"parametro\", "
"\"parametri\")}"

# Label: function.class
#: function.class
msgid "{{#label}} must be a class"
msgstr "{{#label}} deve essere una classe"

# Label: function.maxArity
#: function.maxArity
msgid "{{#label}} must have an arity lesser or equal to {{#n}}"
msgstr ""
"{{#label}} deve avere al massimo {{#n}} {if(#n == 1, \"parametro\", "
"\"parametri\")}"

# Label: function.minArity
#: function.minArity
msgid "{{#label}} must have an arity greater or equal to {{#n}}"
msgstr ""
"{{#label}} deve avere almeno {{#n}} {if(#n == 1, \"parametro\", "
"\"parametri\")}"

# Label: link.depth
#: link.depth
msgid "{{#label}} exceeds maximum recursion depth supported by the runtime"
msgstr ""
"{{#label}} supera la profondità massima di ricorsione supportata "
"dall'ambiente di esecuzione"

# Label: link.maxRecursion
#: link.maxRecursion
msgid "{{#label}} exceeds maximum recursion depth of {{#limit}}"
msgstr "{{#label}} supera la profondità massima di ricorsione di {{#limit}}"

# Label: number.base
#: number.base
msgid "{{#label}} must be a number"
msgstr "{{#label}} deve essere un numero"

# Label: number.greater
#: number.greater
msgid "{{#label}} must be greater than {{#limit}}"
msgstr "{{#label}} deve essere maggiore di {{#limit}}"

# Label: number.infinity
#: number.infinity
msgid "{{#label}} cannot be infinity"
msgstr "{{#label}} non può essere infinito"

# Label: number.integer
#: number.integer
msgid "{{#label}} must be an integer"
msgstr "{{#label}} deve essere un numero intero"

# Label: number.less
#: number.less
msgid "{{#label}} must be less than {{#limit}}"
msgstr "{{#label}} deve essere minore di {{#limit}}"

# Label: number.max
#: number.max
msgid "{{#label}} must be less than or equal to {{#limit}}"
msgstr "{{#label}} non può essere maggiore di {{#limit}}"

# Label: number.min
#: number.min
msgid "{{#label}} must be greater than or equal to {{#limit}}"
msgstr "{{#label}} non può essere minore di {{#limit}}"

# Label: number.multiple
#: number.multiple
msgid "{{#label}} must be a multiple of {{#multiple}}"
msgstr "{{#label}} deve essere un multiplo di {{#multiple}}"

# Label: number.negative
#: number.negative
msgid "{{#label}} must be a negative number"
msgstr "{{#label}} deve essere un numero negativo"

# Label: number.port
#: number.port
msgid "{{#label}} must be a valid port"
msgstr "{{#label}} deve essere un numero di porta valido"

# Label: number.positive
#: number.positive
msgid "{{#label}} must be a positive number"
msgstr "{{#label}} deve essere un numero positivo"

# Label: number.precision
#: number.precision
msgid "{{#label}} must have no more than {{#limit}} decimal places"
msgstr ""
"{{#label}} può avere al massimo {{#limit}} {if(#limit == 1, \"cifra "
"decimale\", \"cifre decimali\")}"

# Label: number.unsafe
#: number.unsafe
msgid "{{#label}} must be a safe number"
msgstr "{{#label}} supera i limiti di precisione numerica di JavaScript"

# Label: string.alphanum
#: string.alphanum
msgid "{{#label}} must only contain alpha-numeric characters"
msgstr "{{#label}} può contenere solo lettere (a-z, A-Z) e numeri (0-9)"

# Label: string.base
#: string.base
msgid "{{#label}} must be a string"
msgstr "{{#label}} deve essere una stringa"

# Label: string.base64
#: string.base64
msgid "{{#label}} must be a valid base64 string"
msgstr "{{#label}} deve essere una stringa valida in Base64"

# Label: string.creditCard
#: string.creditCard
msgid "{{#label}} must be a credit card"
msgstr "{{#label}} deve essere un numero di carta di credito valido"

# Label: string.dataUri
#: string.dataUri
msgid "{{#label}} must be a valid dataUri string"
msgstr "{{#label}} deve essere un URI di dati valido"

# Label: string.domain
#: string.domain
msgid "{{#label}} must contain a valid domain name"
msgstr "{{#label}} deve contenere un nome di dominio valido"

# Label: string.email
#: string.email
msgid "{{#label}} must be a valid email"
msgstr "{{#label}} deve essere un indirizzo email valido"

# Label: string.empty
#: string.empty
msgid "{{#label}} is not allowed to be empty"
msgstr "{{#label}} non può essere vuoto"

# Label: string.guid
#: string.guid
msgid "{{#label}} must be a valid GUID"
msgstr "{{#label}} deve essere un GUID valido"

# Label: string.hex
#: string.hex
msgid "{{#label}} must only contain hexadecimal characters"
msgstr "{{#label}} può contenere solo caratteri esadecimali"

# Label: string.hexAlign
#: string.hexAlign
msgid "{{#label}} hex decoded representation must be byte aligned"
msgstr "{{#label}} deve contenere un numero pari di caratteri esadecimali"

# Label: string.hostname
#: string.hostname
msgid "{{#label}} must be a valid hostname"
msgstr "{{#label}} deve essere un nome host valido"

# Label: string.ip
#: string.ip
msgid "{{#label}} must be a valid ip address with a {{#cidr}} CIDR"
msgstr ""
"{{#label}} deve essere un indirizzo IP valido {{if(#cidr == \"required\", "
"\"con notazione CIDR\", if(#cidr == \"optional\", \"con o senza notazione "
"CIDR\", if(#cidr == \"forbidden\", \"senza notazione CIDR\", #cidr)))}}"

# Label: string.ipVersion
#: string.ipVersion
msgid ""
"{{#label}} must be a valid ip address of one of the following versions "
"{{#version}} with a {{#cidr}} CIDR"
msgstr ""
"{{#label}} deve essere un indirizzo IP valido {{if(#cidr == \"required\", "
"\"con notazione CIDR\", if(#cidr == \"optional\", \"con o senza notazione "
"CIDR\", if(#cidr == \"forbidden\", \"senza notazione CIDR\", #cidr)))}} "
"(versioni consentite: {{#version}})"

# Label: string.isoDate
#: string.isoDate
msgid "{{#label}} must be in iso format"
msgstr "{{#label}} deve essere una data in formato ISO 8601"

# Label: string.isoDuration
#: string.isoDuration
msgid "{{#label}} must be a valid ISO 8601 duration"
msgstr "{{#label}} deve essere una durata valida in formato ISO 8601"

# Label: string.length
#: string.length
msgid "{{#label}} length must be {{#limit}} characters long"
msgstr ""
"{{#label}} deve contenere esattamente {{#limit}} {if(#limit == 1, "
"\"carattere\", \"caratteri\")}"

# Label: string.lowercase
#: string.lowercase
msgid "{{#label}} must only contain lowercase characters"
msgstr "Tutte le lettere di {{#label}} devono essere minuscole"

# Label: string.max
#: string.max
msgid ""
"{{#label}} length must be less than or equal to {{#limit}} characters long"
msgstr ""
"{{#label}} deve contenere al massimo {{#limit}} {if(#limit == 1, "
"\"carattere\", \"caratteri\")}"

# Label: string.min
#: string.min
msgid "{{#label}} length must be at least {{#limit}} characters long"
msgstr ""
"{{#label}} deve contenere almeno {{#limit}} {if(#limit == 1, \"carattere\", "
"\"caratteri\")}"

# Label: string.normalize
#: string.normalize
msgid "{{#label}} must be unicode normalized in the {{#form}} form"
msgstr "{{#label}} deve usare la forma di normalizzazione Unicode {{#form}}"

# Label: string.token
#: string.token
msgid "{{#label}} must only contain alpha-numeric and underscore characters"
msgstr ""
"{{#label}} può contenere solo lettere (a-z, A-Z), numeri (0-9) e trattini "
"bassi (_)"

# Label: string.pattern.base
#: string.pattern.base
msgid ""
"{{#label}} with value {:[.]} fails to match the required pattern: {{#regex}}"
msgstr ""
"{{#label}}, con valore {:[.]}, non corrisponde al pattern richiesto: "
"{{#regex}}"

# Label: string.pattern.name
#: string.pattern.name
msgid "{{#label}} with value {:[.]} fails to match the {{#name}} pattern"
msgstr "{{#label}}, con valore {:[.]}, non corrisponde al pattern {{#name}}"

# Label: string.pattern.invert.base
#: string.pattern.invert.base
msgid "{{#label}} with value {:[.]} matches the inverted pattern: {{#regex}}"
msgstr ""
"{{#label}}, con valore {:[.]}, corrisponde al pattern non consentito: "
"{{#regex}}"

# Label: string.pattern.invert.name
#: string.pattern.invert.name
msgid "{{#label}} with value {:[.]} matches the inverted {{#name}} pattern"
msgstr ""
"{{#label}}, con valore {:[.]}, corrisponde al pattern non consentito "
"{{#name}}"

# Label: string.trim
#: string.trim
msgid "{{#label}} must not have leading or trailing whitespace"
msgstr "{{#label}} non può iniziare o terminare con spazi bianchi"

# Label: string.uri
#: string.uri
msgid "{{#label}} must be a valid uri"
msgstr "{{#label}} deve essere un URI valido"

# Label: string.uriCustomScheme
#: string.uriCustomScheme
msgid ""
"{{#label}} must be a valid uri with a scheme matching the {{#scheme}} pattern"
msgstr ""
"{{#label}} deve essere un URI valido con uno schema che corrisponde al "
"pattern {{#scheme}}"

# Label: string.uriRelativeOnly
#: string.uriRelativeOnly
msgid "{{#label}} must be a valid relative uri"
msgstr "{{#label}} deve essere un URI relativo valido"

# Label: string.uppercase
#: string.uppercase
msgid "{{#label}} must only contain uppercase characters"
msgstr "Tutte le lettere di {{#label}} devono essere maiuscole"

# Label: symbol.base
#: symbol.base
msgid "{{#label}} must be a symbol"
msgstr "{{#label}} deve essere un valore di tipo Symbol"

# Label: symbol.map
#: symbol.map
msgid "{{#label}} must be one of {{#map}}"
msgstr "{{#label}} deve essere uno dei seguenti valori: {{#map}}"

# Label: binary.base
#: binary.base
msgid "{{#label}} must be a buffer or a string"
msgstr "{{#label}} deve essere un oggetto Buffer o una stringa"

# Label: binary.length
#: binary.length
msgid "{{#label}} must be {{#limit}} bytes"
msgstr "{{#label}} deve avere una dimensione di esattamente {{#limit}} byte"

# Label: binary.max
#: binary.max
msgid "{{#label}} must be less than or equal to {{#limit}} bytes"
msgstr "La dimensione di {{#label}} non può superare {{#limit}} byte"

# Label: binary.min
#: binary.min
msgid "{{#label}} must be at least {{#limit}} bytes"
msgstr "{{#label}} deve avere una dimensione di almeno {{#limit}} byte"
