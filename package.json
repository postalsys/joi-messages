{
    "name": "@postalsys/joi-messages",
    "version": "1.3.1",
    "description": "Extract translatable messages from Joi",
    "main": "index.js",
    "files": [
        "index.js",
        "translations/"
    ],
    "scripts": {
        "pot": "node gen-pot.js",
        "test": "node --test test/messages-test.js",
        "test:coverage": "c8 npm test",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install"
    },
    "keywords": [],
    "author": "Andris Reinman",
    "license": "MIT",
    "engines": {
        "node": ">=20.0.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "c8": "12.0.0",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.13.0",
        "joi": "18.2.9",
        "prettier": "3.9.10"
    },
    "dependencies": {
        "gettext-parser": "7.0.1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/postalsys/joi-messages.git"
    }
}
