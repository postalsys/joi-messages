{
    "name": "@postalsys/joi-messages",
    "version": "1.4.0",
    "description": "Extract translatable messages from Joi",
    "type": "module",
    "main": "./dist/cjs/index.js",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./index": "./dist/cjs/index.js",
        "./index.js": "./dist/cjs/index.js",
        "./package.json": "./package.json",
        "./translations/*": "./translations/*"
    },
    "files": [
        "dist",
        "translations/"
    ],
    "scripts": {
        "build": "node scripts/build.js",
        "typecheck": "tsc -p tsconfig.json",
        "pot": "node scripts/gen-pot.js",
        "pretest": "npm run build",
        "test": "node --import tsx --test $(find test -name \"*.test.ts\")",
        "pretest:coverage": "npm run build",
        "test:coverage": "c8 node --import tsx --test $(find test -name \"*.test.ts\")",
        "pretest:cjs": "npm run build",
        "test:cjs": "NODE_OPTIONS=--no-experimental-require-module node test/package/cjs-smoke.cjs",
        "lint": "npm run typecheck && eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.{js,cjs,ts,json,md,yml,yaml}\"",
        "format:check": "prettier --check \"**/*.{js,cjs,ts,json,md,yml,yaml}\"",
        "prepare": "npm run build",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install"
    },
    "keywords": [],
    "author": "Andris Reinman",
    "license": "MIT",
    "engines": {
        "node": ">=20.0.0"
    },
    "devDependencies": {
        "@types/node": "20.19.43",
        "c8": "12.0.0",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "gettext-parser": "7.0.1",
        "globals": "17.13.0",
        "joi": "18.2.9",
        "prettier": "3.9.10",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.2"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/postalsys/joi-messages.git"
    }
}
